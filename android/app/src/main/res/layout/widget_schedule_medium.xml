<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/widget_card_bg">

    <!-- Header: Badge & Interactive Day Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_eagle_buddy"
            android:contentDescription="Bayani" />

        <TextView
            android:id="@+id/widget_medium_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCHEDULE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#3B82F6"
            android:background="@drawable/widget_badge_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Interactive Day Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_medium_btn_prev"
                android:layout_width="24dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="‹"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#93C5FD"
                android:background="@drawable/widget_btn_bg" />

            <TextView
                android:id="@+id/widget_medium_count"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:gravity="center"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="3 classes today"
                android:textSize="10sp"
                android:textColor="#CBD5E1"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_medium_btn_next"
                android:layout_width="24dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="›"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#93C5FD"
                android:background="@drawable/widget_btn_bg" />

            <TextView
                android:id="@+id/widget_medium_btn_refresh"
                android:layout_width="24dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="↻"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:background="@drawable/widget_btn_bg" />

            <TextView
                android:id="@+id/widget_medium_btn_add"
                android:layout_width="24dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="+"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#38BDF8"
                android:background="@drawable/widget_btn_bg" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center: Main Active/Next Class -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_medium_current_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MATH 21 • Calculus I"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_medium_current_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="09:00 AM - 10:30 AM • Room 401"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#1E293B" />

    <!-- Bottom: Next class or upcoming status -->
    <TextView
        android:id="@+id/widget_medium_upcoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next: CS 102 Data Structures • 01:00 PM"
        android:textSize="10sp"
        android:textColor="#38BDF8"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
