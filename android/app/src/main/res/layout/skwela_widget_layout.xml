<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skwela_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top Header Bar: Title, Refresh & Count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_eagle_buddy"
            android:contentDescription="Bayani" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIMETABLE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#30D158"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_tasks_badge_bg" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/skwela_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textSize="10sp"
            android:textColor="#94A3B8" />

        <TextView
            android:id="@+id/skwela_widget_btn_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="↻"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:background="@drawable/widget_btn_bg" />
    </LinearLayout>

    <!-- Center: Main Class Subject -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_current_class"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SkwelaDabaw • No Active Classes Today"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/skwela_widget_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="All clear for today"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom: Upcoming class or status -->
    <TextView
        android:id="@+id/widget_next_class"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Up Next • Free Time"
        android:textSize="10sp"
        android:textColor="#34D399"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
