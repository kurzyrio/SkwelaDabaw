<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ov_sheet_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/ov_sheet_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Quiet Top Row: Live Weather Pill + Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ov_weather_pill"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="11dp"
                android:paddingEnd="11dp">

                <ImageView
                    android:id="@+id/ov_weather_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="7dp"
                    android:contentDescription="Weather"
                    android:src="@drawable/ic_ov_weather" />

                <TextView
                    android:id="@+id/ov_weather_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Davao Weather"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ov_weather_heat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ov_sheet_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:clickable="true"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_ov_close" />
        </LinearLayout>

        <!-- Single Focal Hero Block: Live Ongoing / Next Class -->
        <LinearLayout
            android:id="@+id/ov_class_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/ov_class_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="7dp" />

                <TextView
                    android:id="@+id/ov_class_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All clear"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/ov_class_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No classes today"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ov_class_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Optional Single-Line Task Peek -->
        <LinearLayout
            android:id="@+id/ov_task_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ov_task_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="9dp"
                android:contentDescription="Task"
                android:src="@drawable/ic_ov_check_circle" />

            <TextView
                android:id="@+id/ov_task_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ov_task_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 4-Shortcut Quick-Jump Dock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ov_nav_schedule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/ov_nav_schedule_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="5dp"
                    android:contentDescription="Schedule"
                    android:src="@drawable/ic_ov_schedule" />

                <TextView
                    android:id="@+id/ov_nav_schedule_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Schedule"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ov_nav_jeep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/ov_nav_jeep_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="5dp"
                    android:contentDescription="Jeep"
                    android:src="@drawable/ic_ov_jeep" />

                <TextView
                    android:id="@+id/ov_nav_jeep_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jeep"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ov_nav_bus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/ov_nav_bus_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="5dp"
                    android:contentDescription="DC Bus"
                    android:src="@drawable/ic_ov_bus" />

                <TextView
                    android:id="@+id/ov_nav_bus_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DC Bus"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ov_nav_tasks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/ov_nav_tasks_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="5dp"
                    android:contentDescription="Tasks"
                    android:src="@drawable/ic_ov_tasks" />

                <TextView
                    android:id="@+id/ov_nav_tasks_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tasks"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
