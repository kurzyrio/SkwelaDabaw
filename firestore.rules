rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All application data (user profiles, schedules, tasks, community chat)
    // is securely managed on the backend database.
    // Firebase is used exclusively for Firebase Authentication (Google Sign-In).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
