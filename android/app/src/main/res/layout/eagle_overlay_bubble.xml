<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="58dp"
    android:layout_height="58dp"
    android:background="@drawable/eagle_bubble_bg"
    android:elevation="8dp">

    <ImageView
        android:id="@+id/bubble_mascot"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_eagle_buddy"
        android:contentDescription="Eagle Mascot" />

    <View
        android:id="@+id/bubble_active_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="3dp"
        android:background="@drawable/eagle_bubble_bg"
        android:visibility="gone" />
</FrameLayout>
