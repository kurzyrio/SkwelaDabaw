# Firebase Web App Configuration (from Firebase Console)
# ⚠️ WARNING: All VITE_ prefixed variables are compiled into the CLIENT-SIDE
# JavaScript bundle by Vite. They are PUBLIC and visible to anyone.
# Never put true secrets (server keys, database passwords) here.
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=skweladabaw.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=skweladabaw
VITE_FIREBASE_STORAGE_BUCKET=skweladabaw.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=981655805429
VITE_FIREBASE_APP_ID=1:981655805429:web:...
VITE_FIREBASE_MEASUREMENT_ID=G-...

# Google Gemini API Key — for LOCAL DEVELOPMENT ONLY.
# In production, users provide their own free key via Settings > AI Scanner.
# Get a free key at: https://aistudio.google.com/app/apikey
# DO NOT hardcode this in source code — it will be exposed in the JS bundle.
# VITE_GEMINI_API_KEY=

# Backend Sync API (optional)
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=10000
