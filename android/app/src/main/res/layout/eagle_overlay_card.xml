<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="336dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/eagle_card_bg"
    android:padding="16dp"
    android:elevation="16dp">

    <!-- Header with Live Branding & Interactive Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_eagle_buddy"
            android:contentDescription="Eagle Buddy"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eagle Companion"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/card_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Student Quick Glance"
                android:textSize="11sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <!-- Interactive Refresh Button -->
        <TextView
            android:id="@+id/card_btn_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="↻"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh Data"
            android:layout_marginEnd="2dp" />

        <!-- Close Button -->
        <TextView
            android:id="@+id/card_btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Overlay" />
    </LinearLayout>

    <!-- Weather Advisory Banner (Clickable -> Opens Weather) -->
    <LinearLayout
        android:id="@+id/card_weather_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/notification_next_container_bg"
        android:padding="10dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/card_weather_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="31°C"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/card_weather_cond"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Davao City • Partly Cloudy"
                android:textSize="13sp"
                android:textColor="#F1F5F9"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap for forecast details"
                android:textSize="10sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <TextView
            android:id="@+id/card_weather_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Heat: 36°C"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FBBF24"
            android:background="@drawable/notification_chip_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Interactive Mode Switcher (Classes vs Tasks) -->
    <LinearLayout
        android:id="@+id/card_tab_container"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/card_tab_classes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Classes"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:background="@drawable/notification_current_pill_bg"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/card_tab_tasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tasks"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:background="@drawable/notification_chip_bg" />
    </LinearLayout>

    <!-- 1. Class Section -->
    <LinearLayout
        android:id="@+id/card_classes_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/notification_next_container_bg"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/card_class_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPCOMING CLASS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8" />

        <TextView
            android:id="@+id/card_class_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No Classes Today"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/card_class_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Free schedule"
            android:textSize="13sp"
            android:textColor="#CBD5E1"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 2. Tasks Section (Toggled via card_tab_tasks) -->
    <LinearLayout
        android:id="@+id/card_tasks_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/notification_next_container_bg"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/card_task_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENDING DEADLINES"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#30D158" />

        <TextView
            android:id="@+id/card_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All caught up!"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/card_task_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No pending assignments"
            android:textSize="13sp"
            android:textColor="#CBD5E1"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Primary Launch Action -->
    <Button
        android:id="@+id/card_btn_open_app"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Open SkwelaDabaw"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/notification_current_pill_bg"
        android:layout_marginBottom="10dp" />

    <!-- Quick Navigation Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/card_action_timetable"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Timetable"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/notification_chip_bg"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/card_action_bus"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="DC Bus"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:background="@drawable/notification_chip_bg"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/card_action_tasks"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tasks"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#30D158"
            android:background="@drawable/notification_chip_bg" />
    </LinearLayout>
</LinearLayout>
